<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>to: najwa 🌕</title>
  <!-- Canvas Confetti Library -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts: Inter untuk teks sangat jelas & mudah dibaca -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: #2d3748;
      position: relative;
      overflow-x: hidden;

      /* Lukisan Padang Rumput Malam Hari dengan Bulan Purnama & Bintang */
      background: 
        /* Lapisan Bintang Berkilau */
        radial-gradient(2px 2px at 20px 30px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(2px 2px at 40px 70px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(1.5px 1.5px at 90px 40px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(2px 2px at 160px 120px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(1.5px 1.5px at 230px 80px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(2px 2px at 300px 150px, #ffffff, rgba(0,0,0,0)),
        
        /* Bulatan Bulan Purnama Berpendar */
        radial-gradient(circle at 80% 20%, #fffde7 0%, #fff9c4 4%, rgba(255, 249, 196, 0.3) 12%, transparent 30%),
        
        /* Siluet Bukit Padang Rumput Malam Hari */
        radial-gradient(circle at 20% 120%, #15291b 0%, #0d1a11 45%, transparent 60%),
        radial-gradient(circle at 80% 120%, #1b3823 0%, #09150c 50%, transparent 65%),
        
        /* Gradasi Langit Malam */
        linear-gradient(to bottom, #050b14 0%, #0a192f 40%, #112240 75%, #1a3636 100%);
      
      background-repeat: repeat, repeat, repeat, repeat, repeat, repeat, no-repeat, no-repeat, no-repeat, no-repeat;
      background-size: 350px 350px, 400px 400px, 250px 250px, 300px 300px, 200px 200px, 450px 450px, 100% 100%, 100% 100%, 100% 100%, 100% 100%;
    }

    .card-container {
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      max-width: 520px;
      width: 100%;
      border-radius: 24px;
      padding: 36px 28px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      text-align: center;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Progress Indicator */
    .progress-bar {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-bottom: 28px;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #cbd5e0;
      transition: all 0.3s ease;
    }

    .dot.active {
      background-color: #1a365d;
      width: 24px;
      border-radius: 10px;
    }

    /* Step / Page Styling */
    .page {
      display: none;
      animation: fadeIn 0.4s ease-in-out forwards;
    }

    .page.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .icon-emoji {
      font-size: 3.5rem;
      margin-bottom: 16px;
      display: inline-block;
    }

    h1 {
      font-size: 1.75rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 12px;
      line-height: 1.3;
      letter-spacing: -0.02em;
    }

    p.subtext {
      font-size: 1.05rem;
      color: #334155;
      line-height: 1.6;
      font-weight: 400;
      margin-bottom: 24px;
    }

    /* Options / Buttons */
    .btn-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .btn {
      width: 100%;
      background-color: #1e293b;
      color: #ffffff;
      border: none;
      padding: 14px 24px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    .btn:hover {
      background-color: #0f172a;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.3);
    }

    .btn:active {
      transform: translateY(0);
    }

    /* Quiz Option Custom Style */
    .option-btn {
      text-align: left;
      background-color: #f8fafc;
      color: #1e293b;
      border: 2px solid #e2e8f0;
      padding: 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-radius: 14px;
      cursor: pointer;
      font-weight: 500;
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    .option-btn:hover {
      border-color: #334155;
      background-color: #f1f5f9;
    }

    /* Gallery Grid */
    .gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin: 20px 0;
    }

    .gallery img {
      width: 100%;
      height: 130px;
      object-fit: cover;
      border-radius: 12px;
    }

    /* Audio Player Hidden */
    audio {
      display: none;
    }
  </style>
</head>
<body>

  <!-- Musik Background (Shape of My Heart) -->
  <audio id="bg-music" loop>
    <source src="lagu.mp3" type="audio/mpeg">
  </audio>

  <div class="card-container">
    
    <!-- Dots Progress -->
    <div class="progress-bar">
      <div class="dot active" id="dot-1"></div>
      <div class="dot" id="dot-2"></div>
      <div class="dot" id="dot-3"></div>
      <div class="dot" id="dot-4"></div>
      <div class="dot" id="dot-5"></div>
    </div>

    <!-- HALAMAN 1: Pembuka -->
    <div class="page active" id="page-1">
      <span class="icon-emoji">✉️</span>
      <h1>akuu ada pesan rahasia buat kamu wa</h1>
      <p class="subtext">tapi sebelum buka pesan utamanya, kamu harus jawab 2 pertanyaan aku dulu yaaa. okeeyy lets gooo</p>
      <button class="btn" onclick="nextPage(2)">let's goooo 🚀</button>
    </div>

    <!-- HALAMAN 2: Pertanyaan 1 -->
    <div class="page" id="page-2">
      <span class="icon-emoji">🤔</span>
      <h1>Pertanyaan Pertama</h1>
      <p class="subtext">hari ini ada yang bertambah usia nih... kamuu tau enggak siapa orangnyaa?</p>
      <div class="btn-group">
        <button class="option-btn" onclick="nextPage(3)"><span>A.</span> najwa 🌕</button>
        <button class="option-btn" onclick="nextPage(3)"><span>B.</span> kamuu dong ✨</button>
        <button class="option-btn" onclick="nextPage(3)"><span>C.</span> dua-duanya bener 🎉</button>
      </div>
    </div>

    <!-- HALAMAN 3: Pertanyaan 2 -->
    <div class="page" id="page-3">
      <span class="icon-emoji">🎁</span>
      <h1>Pertanyaan Kedua</h1>
      <p class="subtext">ini kan hari ulang tahun kamuu, sekarang harapan apa yang paling kamu mau?</p>
      <div class="btn-group">
        <button class="option-btn" onclick="nextPage(4)"><span>1.</span> makin sukses, sehat & banyak rezeki 💰</button>
        <button class="option-btn" onclick="nextPage(4)"><span>2.</span> Impian & cita-cita tercapai tahun ini 🌟</button>
        <button class="option-btn" onclick="nextPage(4)"><span>3.</span> Selalu bahagia bersama orang tersayang ❤️</button>
      </div>
    </div>

    <!-- HALAMAN 4: Transisi Sebelum Musik -->
    <div class="page" id="page-4">
      <span class="icon-emoji">🎵</span>
      <h1>Satu Langkah Lagi!</h1>
      <p class="subtext">pencet tombol di bawah buat nyalain musik dan buka kartu ucapan buat kamuu!</p>
      <button class="btn" onclick="bukaKejutanUtama()">kartu ucapan spesial ✨</button>
    </div>

    <!-- HALAMAN 5: Puncak Kejutan & Ucapan Utama -->
    <div class="page" id="page-5">
      <span class="icon-emoji">🎉</span>
      <!-- GANTI NAMA TEMAN DI SINI -->
      <h1>selamat ulang tahun najwaa 🎂</h1>
      
      <!-- GANTI PESAN / DOA DI SINI -->
      <p class="subtext">
        Happy birthday awaa! Wish you all the best. Semoga di hari spesial kamuu ini kamuu dikelilingi kebahagian dan dipenuhi rasa syukur,sehat selaluu! 🌟
      </p>

      <!-- GALERI FOTO KENANGAN -->
      <div class="gallery">
        <img src="https://picsum.photos/300/300?random=1" alt="Foto 1">
        <img src="https://picsum.photos/300/300?random=2" alt="Foto 2">
        <img src="https://picsum.photos/300/300?random=3" alt="Foto 3">
        <img src="https://picsum.photos/300/300?random=4" alt="Foto 4">
      </div>

      <div class="btn-group">
        <button class="btn" onclick="lemparKonfeti()">Tiup Lilin / Efek Konfeti 🎊</button>
      </div>
    </div>

  </div>

  <script>
    const music = document.getElementById('bg-music');
    let currentPage = 1;

    function updateDots(pageNumber) {
      for (let i = 1; i <= 5; i++) {
        const dot = document.getElementById(`dot-${i}`);
        if (i === pageNumber) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      }
    }

    function nextPage(pageNumber) {
      document.getElementById(`page-${currentPage}`).classList.remove('active');
      document.getElementById(`page-${pageNumber}`).classList.add('active');
      currentPage = pageNumber;
      updateDots(pageNumber);
    }

    function bukaKejutanUtama() {
      // Putar lagu Shape of My Heart
      music.play().catch(err => console.log("Autoplay ditahan browser"));
      
      // Pindah ke halaman 5
      nextPage(5);

      // Jalankan efek konfeti
      lemparKonfeti();
    }

    function lemparKonfeti() {
      confetti({
        particleCount: 120,
        spread: 80,
        origin: { y: 0.6 }
      });
    }
  </script>
</body>
</html>
